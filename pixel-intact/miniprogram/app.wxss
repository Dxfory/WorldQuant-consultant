page {
  min-height: 100%;
  background: #0c0907;
  color: #ece4d4;
  font-family: -apple-system, "PingFang SC", "Hiragino Sans GB", sans-serif;
  box-sizing: border-box;
}

.page {
  padding: 32rpx 32rpx 80rpx;
}

.lede {
  color: #b7aa94;
  font-size: 26rpx;
  line-height: 1.65;
}

.btn {
  border: 1rpx solid #3a2d1f;
  background: transparent;
  color: #ece4d4;
  font-size: 28rpx;
  line-height: 2.1;
}

.btn-primary {
  background: #e0a45a;
  color: #1a1008;
  border-color: #e0a45a;
  font-weight: 600;
}

.btn-primary[disabled],
.btn[disabled] {
  opacity: 0.4;
}

.badge {
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  border: 1rpx solid #3a2d1f;
  color: #b7aa94;
  font-size: 24rpx;
}

.badge-good {
  color: #8fbf7a;
  border-color: rgba(143, 191, 122, 0.45);
}

.badge-wait {
  color: #d29b4a;
  border-color: rgba(210, 155, 74, 0.45);
}

.panel {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #211910;
  border: 1rpx solid #3a2d1f;
}

.meta-row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #3a2d1f;
  font-size: 24rpx;
}

.meta-row text:first-child {
  color: #b7aa94;
}

.hint {
  color: #b7aa94;
  font-size: 22rpx;
  line-height: 1.55;
}

.hint-warn {
  color: #d29b4a;
}

.hint-danger {
  color: #d36b5a;
}

.item-title {
  display: block;
  margin-bottom: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.link {
  color: #e0a45a;
  font-size: 26rpx;
}
