.pair {
  display: flex;
  gap: 16rpx;
  margin: 24rpx 0 20rpx;
}

.field {
  flex: 1;
  font-size: 24rpx;
  color: #b7aa94;
}

.field input {
  margin-top: 8rpx;
  padding: 10rpx;
  background: #120e0a;
  color: #ece4d4;
  border: 1rpx solid #3a2d1f;
}

.work {
  position: fixed;
  left: -2000px;
  width: 10px;
  height: 10px;
}

.preview {
  width: 100%;
  margin-top: 24rpx;
  border: 1rpx solid #3a2d1f;
}

.list {
  margin-top: 20rpx;
}

.row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.row image {
  width: 96rpx;
  height: 96rpx;
  background: #100c09;
}

.row text {
  font-size: 24rpx;
  color: #b7aa94;
}

.actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.btn-primary {
  margin-bottom: 8rpx;
}
