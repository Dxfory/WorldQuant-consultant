.empty {
  padding: 40rpx 0;
}

.empty .btn {
  margin-top: 28rpx;
}

.preview-box {
  position: relative;
  width: 100%;
  background: #100c09;
  border: 1rpx solid #3a2d1f;
  overflow: hidden;
}

.preview {
  width: 100%;
  display: block;
}

.grid-overlay {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.vline,
.hline {
  position: absolute;
  background: #e0a45a;
}

.vline {
  top: 0;
  bottom: 0;
  width: 4rpx;
  transform: translateX(-50%);
}

.hline {
  left: 0;
  right: 0;
  height: 4rpx;
  transform: translateY(-50%);
}

.work {
  position: fixed;
  left: -2000px;
  top: 0;
  width: 10px;
  height: 10px;
}

.tabs {
  display: flex;
  gap: 12rpx;
  margin-top: 24rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border: 1rpx solid #3a2d1f;
  font-size: 26rpx;
}

.tab.on {
  border-color: #e0a45a;
  color: #e0a45a;
}

.presets,
.modes,
.pair,
.actions {
  display: flex;
  gap: 12rpx;
}

.presets,
.modes {
  margin-bottom: 16rpx;
}

.mini,
.mode-chip {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  background: transparent;
  color: #ece4d4;
  border: 1rpx solid #3a2d1f;
  line-height: 2;
}

.mode-chip {
  padding: 8rpx 0;
}

.mini.on,
.mode-chip.on {
  border-color: #e0a45a;
  color: #e0a45a;
}

.field {
  flex: 1;
  font-size: 24rpx;
  color: #b7aa94;
}

.field input {
  margin-top: 8rpx;
  padding: 10rpx;
  background: #120e0a;
  color: #ece4d4;
  border: 1rpx solid #3a2d1f;
}

.check {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin: 16rpx 0;
  font-size: 24rpx;
  line-height: 1.45;
}

.engine {
  display: block;
  margin-bottom: 16rpx;
  color: #b7aa94;
  font-size: 22rpx;
  line-height: 1.5;
}

.actions {
  margin-top: 24rpx;
}

.full {
  margin-top: 16rpx;
}

.tiles {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
}

.tile {
  width: calc(33.33% - 8rpx);
  background: #140f0b;
  border: 1rpx solid #3a2d1f;
  padding: 8rpx;
  box-sizing: border-box;
}

.tile image {
  width: 100%;
  height: 160rpx;
}

.tile text {
  display: block;
  margin-top: 6rpx;
  font-size: 18rpx;
  color: #b7aa94;
  word-break: break-all;
}
