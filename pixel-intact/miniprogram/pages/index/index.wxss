.hero {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.mark {
  width: 88rpx;
  height: 88rpx;
  border: 1rpx solid #e0a45a;
  color: #e0a45a;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
}

.sub {
  display: block;
  margin-top: 6rpx;
  color: #b7aa94;
  font-size: 24rpx;
}

.actions {
  margin-top: 36rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.grid {
  margin-top: 36rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.card {
  width: calc(50% - 8rpx);
  box-sizing: border-box;
  padding: 20rpx;
  background: #211910;
  border: 1rpx solid #3a2d1f;
}

.card-k {
  display: block;
  color: #e0a45a;
  font-size: 22rpx;
}

.card-t {
  display: block;
  margin: 8rpx 0;
  font-size: 28rpx;
}

.card-d {
  display: block;
  color: #b7aa94;
  font-size: 22rpx;
  line-height: 1.5;
}

.foot-links {
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
